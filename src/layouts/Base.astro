---
/**
 * ASTRO 101 — how a .astro file works:
 * 1. The part between the --- fences is the "component script". It's TypeScript that runs
 *    at BUILD time (on your computer), never in the visitor's browser.
 * 2. Everything below the fences is the template: HTML + {expressions}.
 * 3. <slot /> is where the page's content gets inserted.
 */
import '../styles/global.css';

interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="description" content="William Chan, co-founder and CEO of Nextform Studios in Kuala Lumpur, building software for the web." />
    <meta name="theme-color" content="#2B3BF5" />

    <!-- Fonts: Archivo (condensed headlines), Instrument Serif (accent words), Instrument Sans (text), JetBrains Mono (terminal) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,500..900&family=Instrument+Sans:wght@400;500;600;700&family=Instrument+Serif:ital@0;1&family=JetBrains+Mono:wght@400;600&display=swap"
    />
  </head>
  <body>
    <slot />
  </body>
</html>
