---
/**
 * A hand-drawn signature that writes itself when it scrolls into view.
 * PLACEHOLDER: this is a generic scribble. To use your real signature, sign on paper,
 * trace it into a single-stroke SVG path (e.g. in Figma with the pen tool) and paste
 * the `d` values into `strokes` below.
 */
interface Props {
  class?: string;
  label?: string;
}
const { class: className = '', label = 'Signature' } = Astro.props;

const strokes = [
  'M20 60C30 120 40 130 55 70C60 50 62 50 70 110C78 135 90 90 100 50C104 40 106 100 112 105C118 108 120 80 124 70C128 40 132 20 136 30C140 45 128 100 140 104C150 106 152 40 158 28C162 22 160 90 170 102C178 108 182 80 186 72C190 90 192 104 200 100C210 95 214 70 226 72C240 74 236 104 222 102C212 100 230 70 244 76C252 80 250 102 258 104C266 104 270 76 276 74C282 80 280 100 286 100C292 76 300 72 304 80C308 92 306 104 316 102C340 98 360 60 380 40',
  'M40 132C140 118 260 120 390 106',
];
---

<svg class:list={['signature', className]} viewBox="0 0 400 150" role="img" aria-label={label} data-sign>
  {strokes.map((d, i) => <path d={d} pathLength="1" style={`--n:${i}`} />)}
</svg>

<style>
  .signature { display: block; width: 100%; height: auto; overflow: visible; }
  .signature path {
    fill: none; stroke: var(--sign, var(--accent)); stroke-width: 5;
    stroke-linecap: round; stroke-linejoin: round;
  }
  :global(.js) .signature path {
    stroke-dasharray: 1; stroke-dashoffset: 1;
    transition: stroke-dashoffset 1.8s cubic-bezier(.65, 0, .35, 1);
    transition-delay: calc(.2s + var(--n) * 1.5s);
  }
  :global(.js) .signature.in path { stroke-dashoffset: 0; }
  @media (prefers-reduced-motion: reduce) {
    :global(.js) .signature path { stroke-dashoffset: 0; transition: none; }
  }
</style>
