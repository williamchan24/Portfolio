---
/**
 * A mini terminal visitors can type commands into. The answers are built from your
 * real content (site.ts + your project files), so they stay up to date automatically.
 * Add your own commands in the COMMANDS object below.
 */
import { getCollection } from 'astro:content';
import { site, firstName } from '../config/site';

const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);

// Static answers, worked out at build time
const answers = {
  about: site.about.join('\n\n'),
  projects: projects.map((p) => `• ${p.data.title}${p.data.live ? `  →  ${p.data.live}` : ''}`).join('\n'),
  skills: Object.entries(site.toolkit)
    .map(([group, items]) => `${group}: ${items.join(' · ')}`)
    .join('\n'),
  contact: `Email: ${site.email}\n${Object.entries(site.socials)
    .filter(([, url]) => url)
    .map(([label, url]) => `${label}: ${url}`)
    .join('\n')}`,
};
const user = firstName.toLowerCase();
---

<section id="terminal" class="section">
  <div class="container">
    <h2 class="section-title">Poke around</h2>
    <div class="term" data-answers={JSON.stringify(answers)} data-user={user}>
      <div class="term-bar" aria-hidden="true"><i></i><i></i><i></i></div>
      <div class="term-body" role="log" aria-live="polite">
        <p class="dim">{firstName}'s terminal — type <span class="ok">help</span> to see what you can do.</p>
        <label class="term-line">
          <span class="prompt">{user}@site:~$</span>
          <input type="text" aria-label="Terminal command" autocomplete="off" spellcheck="false" autocapitalize="off" />
        </label>
      </div>
    </div>
  </div>
</section>

<script>
  const term = document.querySelector<HTMLElement>('.term');

  if (term) {
    const answers: Record<string, string> = JSON.parse(term.dataset.answers ?? '{}');
    const user = term.dataset.user;
    const body = term.querySelector<HTMLElement>('.term-body')!;
    const line = term.querySelector<HTMLElement>('.term-line')!;
    const input = line.querySelector<HTMLInputElement>('input')!;
    const history: string[] = [];
    let historyPos = 0;

    const print = (text: string, cls = '') => {
      const p = document.createElement('p');
      p.className = cls;
      p.textContent = text; // textContent = safe, never runs anything typed in
      body.insertBefore(p, line);
      body.scrollTop = body.scrollHeight;
    };

    const COMMANDS: Record<string, () => void> = {
      help: () => print('Commands: about, projects, skills, contact, theme, date, whoami, clear, sudo'),
      about: () => print(answers.about),
      projects: () => print(answers.projects),
      skills: () => print(answers.skills),
      contact: () => print(answers.contact),
      whoami: () => print('a curious visitor 👀'),
      date: () => print(new Date().toString()),
      theme: () => {
        document.querySelector<HTMLButtonElement>('.theme-toggle')?.click();
        print('Theme switched.', 'ok');
      },
      clear: () => body.querySelectorAll('p').forEach((p) => p.remove()),
      sudo: () => print('Nice try. 😄 This incident will be reported.', 'ok'),
    };

    // Clicking anywhere in the terminal puts the cursor in the input (unless selecting text)
    term.addEventListener('click', () => {
      if (!window.getSelection()?.toString()) input.focus({ preventScroll: true });
    });

    input.addEventListener('keydown', (e) => {
      // ↑ / ↓ cycle through previous commands, like a real terminal
      if (e.key === 'ArrowUp' && history.length) {
        historyPos = Math.max(0, historyPos - 1);
        input.value = history[historyPos];
        e.preventDefault();
        return;
      }
      if (e.key === 'ArrowDown' && history.length) {
        historyPos = Math.min(history.length, historyPos + 1);
        input.value = history[historyPos] ?? '';
        e.preventDefault();
        return;
      }
      if (e.key !== 'Enter') return;

      const raw = input.value.trim();
      input.value = '';
      if (!raw) return;
      history.push(raw);
      historyPos = history.length;

      print(`${user}@site:~$ ${raw}`, 'dim');
      const cmd = COMMANDS[raw.split(/\s+/)[0].toLowerCase()];
      if (cmd) cmd();
      else print(`command not found: ${raw}. Try "help".`);
    });
  }
</script>

<style>
  .term {
    background: #0d0d12;
    color: #d4d4d8;
    border: 1px solid #27272f;
    border-radius: 14px;
    overflow: hidden;
    font-family: ui-monospace, 'Cascadia Code', Consolas, monospace;
    font-size: 0.92rem;
    box-shadow: var(--shadow);
  }
  .term-bar {
    display: flex;
    gap: 7px;
    padding: 10px 14px;
    background: #17171f;
    border-bottom: 1px solid #27272f;
  }
  .term-bar i {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    display: block;
  }
  .term-bar i:nth-child(1) { background: #ff5f57; }
  .term-bar i:nth-child(2) { background: #febc2e; }
  .term-bar i:nth-child(3) { background: #28c840; }
  .term-body {
    padding: 14px 16px;
    height: 280px;
    overflow-y: auto;
    cursor: text;
  }
  .term-body :global(p) {
    margin: 0 0 4px;
    white-space: pre-wrap;
    word-break: break-word;
  }
  .term-body :global(.dim) { color: #71717a; }
  .term-body :global(.ok), .ok { color: #4ade80; }
  .prompt { color: #818cf8; white-space: nowrap; }
  .term-line {
    display: flex;
    gap: 8px;
    cursor: text;
  }
  .term-line input {
    flex: 1;
    min-width: 0;
    background: transparent;
    border: 0;
    color: inherit;
    font: inherit;
    outline: none;
    caret-color: #818cf8;
  }
</style>
