---
/**
 * Intro screen: a full ultramarine curtain with the name and a counter, then it lifts away.
 * Shown once per browser tab session, skipped for reduced-motion users, and never shown
 * without JavaScript, so nothing can get stuck.
 */
import { site } from '../config/site';
const [first, ...rest] = site.shortName.split(' ');
---

<!-- Runs before paint: marks JS as on, and decides whether to show the intro at all -->
<script is:inline>
  (function () {
    var root = document.documentElement;
    root.classList.add('js');
    var seen = false;
    try { seen = sessionStorage.getItem('intro-seen') === '1'; } catch (e) {}
    if (seen || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    root.classList.add('is-loading');
    // Safety net: never block the page for more than 4s, whatever happens
    setTimeout(function () { root.classList.remove('is-loading'); }, 4000);
  })();
</script>

<div class="preloader" aria-hidden="true">
  <p class="pl-name">
    <span class="pl-first serif">{first}</span>
    <span class="pl-last display">{rest.join(' ')}</span>
  </p>
  <p class="pl-foot label">Loading the good stuff</p>
  <p class="pl-count display"><span>0</span></p>
</div>

<script>
  const root = document.documentElement;
  const loader = document.querySelector<HTMLElement>('.preloader');

  if (loader && root.classList.contains('is-loading')) {
    const count = loader.querySelector<HTMLElement>('.pl-count span')!;
    const DURATION = 1500;
    const start = performance.now();

    const tick = (now: number) => {
      const t = Math.min((now - start) / DURATION, 1);
      const eased = 1 - Math.pow(1 - t, 3); // fast start, slow finish
      count.textContent = String(Math.round(eased * 100));
      if (t < 1) requestAnimationFrame(tick);
      else {
        root.classList.add('is-loaded');
        try { sessionStorage.setItem('intro-seen', '1'); } catch { /* storage blocked */ }
        setTimeout(() => root.classList.remove('is-loading', 'is-loaded'), 1000);
      }
    };
    requestAnimationFrame(tick);
  }
</script>

<style>
  .preloader { display: none; }
  :global(html.is-loading) { overflow: hidden; }
  :global(html.is-loading) .preloader {
    position: fixed; inset: 0; z-index: 1000;
    display: grid; grid-template-rows: 1fr auto; padding: var(--gutter);
    background: var(--sig); color: #fff;
  }
  :global(html.is-loaded) .preloader {
    clip-path: inset(0 0 100% 0);
    transition: clip-path .9s var(--ease-in-out);
  }
  .pl-name { margin: 0; align-self: center; justify-self: center; text-align: center; }
  .pl-first, .pl-last { display: block; animation: pl-up .9s var(--ease-out) both; }
  .pl-first { font-size: clamp(2.2rem, 6vw, 4.5rem); line-height: 1; color: #fff; }
  .pl-last { font-size: clamp(4.5rem, 18vw, 14rem); animation-delay: .08s; }
  .pl-foot { margin: 0; align-self: end; color: rgb(255 255 255 / .75); }
  .pl-count {
    position: absolute; right: var(--gutter); bottom: calc(var(--gutter) - .1em); margin: 0;
    font-size: clamp(3rem, 9vw, 7rem); font-variant-numeric: tabular-nums;
  }
  @keyframes pl-up { from { opacity: 0; transform: translateY(40%); } }
</style>
