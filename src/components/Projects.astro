---
import { getCollection } from 'astro:content';
import ProjectCard from './ProjectCard.astro';

// Grab every project file, skip drafts, sort by `order`.
const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<section id="projects" class="projects night" aria-labelledby="projects-title">
  <div class="container">
    <div class="p-head">
      <h2 class="heading display" id="projects-title"><span class="serif">Things I've</span>Built</h2>
      <p class="lead">Side projects and experiments. Every one is live, so go and have a play.</p>
    </div>

    {projects.length === 0
      ? <p class="muted">Projects are on their way. Check back soon.</p>
      : <div class="p-grid">{projects.map((project, i) => <ProjectCard project={project} index={i + 1} />)}</div>}
  </div>
</section>

<style>
  .projects { padding: clamp(96px, 12vw, 170px) 0; }
  .p-head { display: flex; justify-content: space-between; align-items: end; gap: 24px 48px; flex-wrap: wrap; margin-bottom: clamp(48px, 7vw, 96px); }
  .p-head .heading { font-size: clamp(4rem, 14vw, 13rem); }
  .p-head .lead { max-width: 32ch; margin: 0 0 1em; }

  .p-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(56px, 7vw, 100px) clamp(24px, 4vw, 64px); }
  /* Stagger the second column down, like a scrapbook */
  .p-grid > :global(:nth-child(even)) { margin-top: clamp(80px, 12vw, 200px); }
  @media (max-width: 760px) {
    .p-grid { grid-template-columns: 1fr; }
    .p-grid > :global(:nth-child(even)) { margin-top: 0; }
  }
</style>
