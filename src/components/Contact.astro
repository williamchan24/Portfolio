---
import { site } from '../config/site';

const fields = [
  { id: 'name', label: 'Name', type: 'text', autocomplete: 'name', max: 100 },
  { id: 'email', label: 'Email', type: 'email', autocomplete: 'email', max: 190 },
] as const;
---

<section id="contact" class="contact night" aria-labelledby="contact-title">
  <div class="container c-grid">
    <div class="c-copy">
      <h2 class="heading display" id="contact-title"><span class="serif">Let's</span>Talk</h2>
      <p class="lead">Got a question, an idea, or just want to chat about something I've made? Drop me a message. I'd love to hear from you.</p>
      <a class="c-studio" href={site.studio.enquireUrl} target="_blank" rel="noopener">
        <span class="label">Have a project in mind?</span>
        <span class="c-studio-line">Enquire through {site.studio.name}, and we'll reply within one business day.</span>
        <span class="go" aria-hidden="true">↗</span>
      </a>
    </div>

    <!--
      The site itself is static HTML, so the form posts to /contact.php (a small PHP file
      that runs on the cPanel server). With JavaScript on, the script below sends it in the
      background; with JS off, the browser posts normally and PHP redirects to a thank-you page.
    -->
    <form id="contact-form" class="form c-form" method="post" action="/contact.php" data-reveal>
      <p class="alert" role="status" hidden></p>

      <!-- Honeypot: hidden from humans, bots fill it in -->
      <div class="hp" aria-hidden="true">
        <label for="website">Website</label>
        <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
      </div>

      {fields.map((f) => (
        <>
          <label for={f.id}>{f.label}</label>
          <input id={f.id} name={f.id} type={f.type} maxlength={f.max} autocomplete={f.autocomplete} required />
          <p class="field-error" data-error-for={f.id} hidden></p>
        </>
      ))}

      <label for="body">Message</label>
      <textarea id="body" name="body" rows="5" minlength="10" maxlength="5000" required></textarea>
      <p class="field-error" data-error-for="body" hidden></p>

      <button class="btn" type="submit">Send message</button>
    </form>
  </div>
</section>

<script>
  type ContactResponse = { ok: boolean; message?: string; errors?: Record<string, string> };

  const form = document.querySelector<HTMLFormElement>('#contact-form');
  const status = form?.querySelector<HTMLParagraphElement>('[role="status"]');
  const button = form?.querySelector<HTMLButtonElement>('button[type="submit"]');

  function showStatus(kind: 'success' | 'error', text: string) {
    if (!status) return;
    status.textContent = text;
    status.className = `alert alert-${kind}`;
    status.hidden = false;
  }

  function clearErrors() {
    if (status) status.hidden = true;
    form?.querySelectorAll<HTMLElement>('[data-error-for]').forEach((el) => {
      el.hidden = true;
      document.getElementById(el.dataset.errorFor!)?.removeAttribute('aria-invalid');
    });
  }

  function showFieldErrors(errors: Record<string, string>) {
    for (const [field, text] of Object.entries(errors)) {
      const el = form?.querySelector<HTMLElement>(`[data-error-for="${field}"]`);
      if (el) {
        el.textContent = text;
        el.hidden = false;
        document.getElementById(field)?.setAttribute('aria-invalid', 'true');
      } else {
        showStatus('error', text); // form-level error, e.g. rate limit
      }
    }
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    clearErrors();
    if (button) {
      button.disabled = true;
      button.textContent = 'Sending…';
    }

    try {
      const res = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });
      const data = (await res.json()) as ContactResponse;

      if (data.ok) {
        form.reset();
        showStatus('success', data.message ?? 'Thanks! Your message has been sent.');
      } else {
        showFieldErrors(data.errors ?? { form: 'Something went wrong. Please try again.' });
      }
    } catch {
      showStatus('error', "Couldn't send right now — please email me directly instead.");
    } finally {
      if (button) {
        button.disabled = false;
        button.textContent = 'Send message';
      }
    }
  });
</script>

<style>
  .contact { padding: clamp(96px, 12vw, 170px) 0; }
  .c-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(40px, 6vw, 96px); align-items: start; }
  .c-copy .heading { font-size: clamp(4rem, 13vw, 12rem); margin-bottom: 24px; }
  .c-copy .lead { margin-bottom: 32px; }
  .c-studio {
    display: grid; grid-template-columns: 1fr auto; align-items: center; gap: 4px 20px;
    padding: 20px 20px 20px 24px; border-radius: var(--radius); border: 1px solid var(--rule);
    text-decoration: none; max-width: 480px; transition: border-color .2s, background-color .2s;
  }
  .c-studio .label { grid-column: 1; color: var(--accent); }
  .c-studio-line { grid-column: 1; font-weight: 600; }
  .c-studio .go { grid-column: 2; grid-row: 1 / 3; }
  @media (hover: hover) and (pointer: fine) {
    .c-studio:hover { border-color: var(--sig); background: rgb(43 59 245 / .12); }
  }
  .c-form { padding: clamp(24px, 3vw, 40px); border-radius: var(--radius); background: var(--night-2); border: 1px solid var(--rule); }
  .c-form label:first-of-type { margin-top: 0; }
  @media (max-width: 860px) {
    .c-grid { grid-template-columns: 1fr; }
  }
</style>
