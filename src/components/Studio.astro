---
/**
 * "Now building" section about Nextform Studios, on the signature blue.
 * All the text lives in site.ts → studio. Project enquiries go to the studio's own contact page.
 */
import { site } from '../config/site';

const { studio } = site;
const [brand, ...brandRest] = studio.name.split(' ');
---

<section id="nextform" class="studio blue" aria-labelledby="studio-title">
  <div class="container">
    <div class="s-head">
      <h2 class="heading display" id="studio-title">
        <span class="serif">Now building</span>
        {brand}<br />{brandRest.join(' ')}
      </h2>
      <a class="s-badge" href={studio.url} target="_blank" rel="noopener" aria-label={`Visit ${studio.name}`}>
        <svg viewBox="0 0 200 200" aria-hidden="true">
          <defs><path id="badge-circle" d="M100 100m-78 0a78 78 0 1 1 156 0a78 78 0 1 1-156 0" /></defs>
          <text><textPath href="#badge-circle">{`${studio.role} ✶ ${studio.name} ✶ `}</textPath></text>
        </svg>
        <span aria-hidden="true">↗</span>
      </a>
    </div>

    <div class="s-grid">
      <div class="s-intro" data-reveal>
        {studio.intro.map((p, i) => <p class={i === 0 ? 'lead' : undefined}>{p}</p>)}
        <dl class="s-facts">
          {Object.entries(studio.facts).map(([label, value]) => (
            <div><dt class="label">{label}</dt><dd>{value}</dd></div>
          ))}
        </dl>
        <div class="s-actions">
          <a class="btn btn-light" href={studio.enquireUrl} target="_blank" rel="noopener">Start a project ↗</a>
          <a class="btn btn-ghost" href={studio.url} target="_blank" rel="noopener">Visit the studio ↗</a>
        </div>
      </div>

      <div class="s-side">
        <p class="label">What we make</p>
        <ol class="services">
          {studio.services.map((s, i) => (
            <li data-reveal style={`--d:${i * 0.05}s`}><span class="label">{String(i + 1).padStart(2, '0')}</span><span class="display">{s}</span></li>
          ))}
        </ol>

        {studio.concepts.length > 0 && (
          <>
            <p class="label concepts-label">Design concepts I helped with</p>
            <ul class="concepts">
              {studio.concepts.map((c) => (
                <li>
                  <a href={c.url} target="_blank" rel="noopener">
                    <span class="c-name">{c.name}</span>
                    <span class="c-note">{c.note} ↗</span>
                  </a>
                </li>
              ))}
            </ul>
          </>
        )}
      </div>
    </div>
  </div>
</section>

<style>
  .studio { padding: clamp(96px, 12vw, 170px) 0; overflow: hidden; }
  .s-head { display: flex; justify-content: space-between; align-items: end; gap: 24px; margin-bottom: clamp(48px, 7vw, 96px); }
  .s-head .heading { font-size: clamp(3.4rem, 11vw, 10.5rem); }

  .s-badge {
    position: relative; flex: none; display: grid; place-items: center;
    width: clamp(120px, 13vw, 170px); aspect-ratio: 1; border-radius: 50%;
    background: #fff; color: var(--sig); text-decoration: none; font-size: 1.8rem;
  }
  .s-badge svg { position: absolute; inset: 0; width: 100%; height: 100%; animation: spin 18s linear infinite; }
  .s-badge text { font: 700 15px var(--f-body); letter-spacing: .16em; text-transform: uppercase; fill: var(--sig); }
  @keyframes spin { to { rotate: 360deg; } }

  .s-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(40px, 6vw, 96px); }
  .s-intro p { color: var(--fg-2); max-width: 52ch; }
  .s-intro .lead { color: #fff; font-size: clamp(1.25rem, 2vw, 1.6rem); line-height: 1.35; }
  .s-facts { display: grid; grid-template-columns: repeat(3, auto); justify-content: start; gap: 20px 40px; margin: 32px 0; }
  .s-facts dd { margin: 4px 0 0; font-weight: 600; }
  .s-actions { display: flex; flex-wrap: wrap; gap: 12px; }
  .s-actions .btn-ghost { color: #fff; border-color: rgb(255 255 255 / .5); }
  @media (hover: hover) and (pointer: fine) {
    .s-actions .btn-ghost:hover { background: #fff; color: var(--sig); border-color: #fff; }
  }

  .services { list-style: none; margin: 14px 0 0; padding: 0; border-top: 1px solid var(--rule); }
  .services li { display: flex; align-items: baseline; gap: 18px; padding: 14px 0; border-bottom: 1px solid var(--rule); }
  .services .display { font-size: clamp(1.8rem, 3.4vw, 3rem); }
  .concepts-label { margin-top: 40px; }
  .concepts { list-style: none; margin: 14px 0 0; padding: 0; display: grid; gap: 10px; }
  .concepts a {
    display: flex; justify-content: space-between; gap: 16px; padding: 16px 20px;
    border-radius: 14px; background: rgb(255 255 255 / .1); text-decoration: none;
    transition: background-color .2s, color .2s;
  }
  .c-name { font-weight: 700; }
  .c-note { color: var(--fg-muted); white-space: nowrap; }
  @media (hover: hover) and (pointer: fine) {
    .concepts a:hover { background: #fff; color: var(--sig); }
    .concepts a:hover .c-note { color: var(--sig); }
  }

  @media (max-width: 860px) {
    .s-grid { grid-template-columns: 1fr; }
    .s-head { flex-direction: column; align-items: start; }
    .s-facts { grid-template-columns: 1fr 1fr; }
  }
  @media (prefers-reduced-motion: reduce) {
    .s-badge svg { animation: none; }
  }
</style>
