---
/**
 * Opening screen: the name set huge around a tilted photo card, over a contour map,
 * with a blue tape band of what I do. A transparent PNG cut-out of you would let the
 * name sit right behind your shoulders instead of a card.
 */
import { site } from '../config/site';
import Topo from './Topo.astro';
import LocalTime from './LocalTime.astro';

const [first, ...rest] = site.shortName.split(' ');
const tape = [site.studio.role + ', ' + site.studio.name, site.headline.replace(/\.$/, ''), 'Based in Kuala Lumpur'];
---

<section class="hero paper" aria-labelledby="hero-name">
  <Topo seed={7} />

  <h1 class="hero-name display" id="hero-name">
    <span class="hn hn-1" data-parallax="-60">{first}</span>
    <span class="hn hn-2" data-parallax="40">{rest.join(' ')}</span>
  </h1>

  {site.photo && (
    <div class="hero-photo" data-parallax="30">
      <img src={site.photo} alt={`Portrait of ${site.shortName}`} width="800" height="1000" fetchpriority="high" />
    </div>
  )}

  <div class="tape blue" aria-hidden="true">
    <div class="tape-track">
      {[0, 1].map(() => (
        <span>{tape.map((t) => <>{t}<i>✶</i></>)}</span>
      ))}
    </div>
  </div>

  <div class="hero-foot">
    <a class="now" href="#nextform">
      <span class="label">Now building</span>
      <span class="now-name">{site.studio.name}</span>
      <span class="go" aria-hidden="true">↓</span>
    </a>
    <div class="hero-meta">
      <p class="sr-only">{site.tagline}</p>
      <LocalTime />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative; overflow: hidden; isolation: isolate;
    min-height: max(640px, 100svh);
    display: grid; grid-template-rows: 1fr auto;
    --topo: #DDD9CE;
  }

  /* "WILLIAM" sits behind the photo card, "CHAN" in front of it */
  .hero-name {
    position: absolute; inset: 0;
    display: flex; flex-direction: column; justify-content: center; align-items: center;
    margin: 0; padding-bottom: 8svh;
    color: var(--sig); line-height: .8; text-align: center;
    font-size: min(24vw, 32svh);
    font-weight: 900; font-stretch: 62%;
    pointer-events: none;
  }
  .hn { display: block; position: relative; }
  .hn-1 { z-index: 0; }
  .hn-2 { z-index: 2; font-size: 1.3em; }

  .hero-photo {
    position: absolute; left: 50%; top: 50%; z-index: 1;
    height: min(52svh, 92vw); aspect-ratio: 4 / 5;
    translate: -50% -58%;
    rotate: -3deg;
    padding: 10px; background: #fff; border-radius: 6px;
    box-shadow: 0 30px 60px -25px rgb(14 15 17 / .45);
  }
  .hero-photo img { width: 100%; height: 100%; object-fit: cover; object-position: top; border-radius: 2px; }

  .tape {
    position: absolute; z-index: 2; left: -5vw; right: -5vw; bottom: clamp(110px, 17svh, 170px);
    rotate: -3.5deg; overflow: hidden; padding: 12px 0;
    box-shadow: 0 10px 30px rgb(43 59 245 / .25);
  }
  .tape-track { display: flex; width: max-content; animation: tape 40s linear infinite; }
  .tape-track span {
    display: flex; align-items: center; white-space: nowrap;
    font: 850 clamp(1rem, 1.8vw, 1.4rem)/1 var(--f-display); font-stretch: 80%;
    text-transform: uppercase; letter-spacing: .04em;
  }
  .tape-track i { font-style: normal; padding: 0 .9em; opacity: .7; }
  @keyframes tape { to { transform: translateX(-50%); } }

  .hero-foot {
    grid-row: 2; position: relative; z-index: 3;
    display: flex; align-items: end; justify-content: space-between; gap: 16px;
    padding: 0 var(--gutter) 22px;
  }
  .now {
    display: grid; grid-template-columns: auto auto; align-items: center; column-gap: 16px;
    padding: 12px 12px 12px 18px; border-radius: 16px; text-decoration: none;
    background: rgb(239 237 230 / .8); backdrop-filter: blur(8px); border: 1px solid var(--line);
  }
  .now .label { grid-column: 1; }
  .now-name { grid-column: 1; font-weight: 700; font-size: 1.05rem; }
  .now .go { grid-column: 2; grid-row: 1 / 3; width: 42px; height: 42px; font-size: 1rem; }
  .hero-meta { padding: 10px 14px; border-radius: 999px; background: rgb(239 237 230 / .8); backdrop-filter: blur(8px); }
  .hero-meta :global(.local-time) { margin: 0; }

  @media (max-width: 640px) {
    .hero-name { font-size: 27vw; padding-bottom: 14svh; }
    .hero-photo { height: auto; width: 62vw; }
    .tape { bottom: 92px; }
    .hero-meta { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .tape-track { animation: none; }
  }
</style>
