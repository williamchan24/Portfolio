---
import Greeting from './Greeting.astro';
import { site, firstName } from '../config/site';
---

<section class="hero">
  <div class="container">
    <Greeting />
    <h1><strong>I'm {firstName}</strong> — {site.headline}</h1>
    <p class="lead">{site.tagline}</p>

    <div class="actions">
      <a class="btn" href="#projects">See my projects</a>
    </div>
  </div>
</section>

<style>
  /* Calm, smaller line under the big animated greeting */
  .hero h1 {
    font-size: clamp(1.4rem, 3vw, 2rem);
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--muted);
    margin-bottom: 0.6em;
  }
  .hero h1 strong {
    color: var(--text);
    font-weight: 800;
  }
  .hero .lead {
    font-size: 1.05rem;
    max-width: 520px;
  }
</style>
