---
// A small reusable "message in the middle of the screen" page, used by 404 and the contact fallbacks.
import Base from '../layouts/Base.astro';

interface Props {
  title: string;
  heading: string;
}
const { title, heading } = Astro.props;
---

<Base title={title}>
  <main class="center-page blue">
    <div class="form">
      <h1 class="display">{heading}</h1>
      <slot />
    </div>
  </main>
</Base>

<style>
  .center-page :global(.btn) { background: #fff; color: var(--sig); border-color: #fff; }
</style>
