---
/**
 * Files in src/pages/ become pages: index.astro → /, 404.astro → /404.html, etc.
 * This page just stacks the section components in order.
 */
import Base from '../layouts/Base.astro';
import Preloader from '../components/Preloader.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Manifesto from '../components/Manifesto.astro';
import OnOff from '../components/OnOff.astro';
import Studio from '../components/Studio.astro';
import Projects from '../components/Projects.astro';
import About from '../components/About.astro';
import Toolkit from '../components/Toolkit.astro';
import Terminal from '../components/Terminal.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import Motion from '../components/Motion.astro';
import { site } from '../config/site';
---

<Base title={site.name}>
  <Preloader />
  <a class="skip-link" href="#main">Skip to content</a>
  <Header />
  <main id="main">
    <Hero />
    <Manifesto />
    <OnOff />
    <Studio />
    <Projects />
    <About />
    <Toolkit />
    <div class="paper terminal-wrap"><Terminal /></div>
    <Contact />
  </main>
  <Footer />
  <Motion />
</Base>

<style>
  .terminal-wrap :global(#terminal) { padding-top: 0; }
</style>
